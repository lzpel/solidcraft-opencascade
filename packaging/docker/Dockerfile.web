# The web app's builder: cadrum's cross-compilation image (rust with the wasm32 target and the
# wasi-sdk C++ toolchain OpenCASCADE, the default kernel backend, needs) plus trunk, which fetches
# the wasm-bindgen and wasm-opt matching the build. packaging/web/build-cadrum.sh builds the image
# and runs the build with the repository mounted; the output lands in dist/web, ready for
# packaging/web/package.sh and the nginx image (packaging/docker/Dockerfile).
FROM ghcr.io/lzpel/cross-wasm32-unknown-unknown

ARG TRUNK_VERSION=v0.21.14
RUN curl -fsSL "https://github.com/trunk-rs/trunk/releases/download/${TRUNK_VERSION}/trunk-x86_64-unknown-linux-gnu.tar.gz" \
    | tar -xz -C /usr/local/bin \
    && trunk --version
